# NVIDIA NIM API key — get from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TomTom Maps API key — get from https://developer.tomtom.com
NEXT_PUBLIC_TOMTOM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Sentinel Hub (for real satellite NDVI in Phase 2)
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
